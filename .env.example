# OMCP Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# LLM Provider API Keys (choose one based on your llm.provider setting)
# =============================================================================

# Google Gemini API Key (for provider: gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (for provider: openai)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (for provider: anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# API Authentication (for the target API you're wrapping)
# =============================================================================

# Bearer token for APIs using bearer auth
API_TOKEN=your-api-token-here

# API Key for APIs using api_key auth
API_KEY=your-api-key-here

# =============================================================================
# OAuth2 Configuration (for APIs using oauth2 auth)
# =============================================================================

OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# =============================================================================
# Optional: Override base URL
# =============================================================================

# API_BASE_URL=https://api.example.com
