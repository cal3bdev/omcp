      "policy_overrides": {}
    },
    {
      "name": "product_catalog",
      "description": "Manage product categories, including listing, creating, and retrieving categories and their associated products.",
      "policy_overrides": {}
    },
    {
      "name": "promotion_management",
      "description": "Manage coupons, including listing, creating, validating, retrieving, and deleting coupons.",
      "policy_overrides": {}
    },
    {
      "name": "health_monitoring",
      "description": "Check the health status of the e-commerce service.",
      "policy_overrides": {}
    },
    {
      "name": "inventory_management",
      "description": "Tools for managing product inventory levels and alerts.",
      "policy_overrides": {}
    },
    {
      "name": "notification_management",
      "description": "Tools for managing user notifications.",
      "policy_overrides": {}
    },
    {
      "name": "order_management",
      "description": "Tools for managing customer orders, invoices, and payments.",
      "policy_overrides": {}
    },
    {
      "name": "payment_processing",
      "description": "Tools for processing payments and managing payment methods.",
      "policy_overrides": {}
    },
    {
      "name": "payment_management",
      "description": "Tools for managing payments, including capturing, refunding, and voiding transactions.",
      "policy_overrides": {}
    },
    {
      "name": "shipping_management",
      "description": "Tools for managing shipments, including creating, updating, and tracking shipments, as well as retrieving shipping rates and validating addresses.",
      "policy_overrides": {}
    },
    {
      "name": "support_operations",
      "description": "Tools for accessing support information, including contact details, FAQs, and support tickets.",
      "policy_overrides": {}
    },
    {
      "name": "support_ticket_management",
      "description": "Tools for managing support tickets, including creation, retrieval, closing, replying, and updating status.",
      "policy_overrides": {}
    },
    {
      "name": "user_management",
      "description": "Tools for managing user accounts, including creation, retrieval, updating, and deletion, as well as accessing user-related information like addresses, orders, reviews, and wishlists.",
